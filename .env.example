# Runtime
NODE_ENV=development
PORT=3001

# PostgreSQL (use a dedicated development database)
DB_HOST=localhost
DB_PORT=5432
DB_USER=shotclock
DB_PASSWORD=replace-me
DB_NAME=shotclock_dev
# Database scripts derive their connection URL from the DB_* values above.

# Use a unique, randomly generated secret of at least 32 bytes.
AUTH_JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes
FRONTEND_URL=http://localhost:3000
# Optional comma-separated exact browser origins. Empty means no browser CORS access.
CORS_ORIGINS=http://localhost:3000

# SMTP: implicit TLS on port 465, or STARTTLS (required by default) on 587.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Only set false for a local, non-production SMTP test server.
SMTP_REQUIRE_TLS=false
SMTP_FROM=Shotclock <no-reply@example.test>
# SMTP_USER=
# SMTP_PASSWORD=

# Optional per-peer, per-route limit per 15 minutes; account limit is 10.
AUTH_RATE_LIMIT_IP=100
# Optional server-to-server gateway attestation, both values required together.
# List exact API-visible gateway IP addresses; no CIDRs.
# AUTH_TRUSTED_GATEWAY_IPS=127.0.0.1,::1
# AUTH_GATEWAY_SECRET=replace-with-a-different-unique-random-secret-at-least-32-bytes
